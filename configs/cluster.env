# ZeroBoot cluster configuration, loaded by docker-compose.yml via env_file.
# These are the only environment variables the binaries read.
# Everything else (ports, pool size, TTL, port range) is a Go constant.

# controller: node-agent gRPC addresses; hosts here are also used to build
# the TCP address returned to the gateway (e.g. node-1:9003)
WORKER_NODES=node-1:50052,node-2:50052

# gateway: where to reach the controller
CONTROLLER_ADDR=controller:50051

# node-agent: path to the sandbox binary inside the worker image
SANDBOX_BINARY=/usr/local/bin/sandbox
